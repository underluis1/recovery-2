# STAGING Environment (Self-hosted)
ENVIRONMENT=staging

# Supabase Self-hosted Configuration
SUPABASE_PROJECT_ID=staging-project
SUPABASE_PROJECT_REF=staging

# Database URLs
SUPABASE_DB_URL=postgresql://postgres:[password]@localhost:6543/postgres?pgbouncer=true
SUPABASE_DB_DIRECT_URL=postgresql://postgres:[password]@localhost:5432/postgres

# Supabase API
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_API_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n Self-hosted Configuration
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=http://localhost:5678

# Server Configuration
SERVER_HOST=staging.yourdomain.com
SSH_USER=deploy
SSH_KEY_PATH=~/.ssh/id_rsa
