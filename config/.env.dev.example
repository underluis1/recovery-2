# DEV Environment (Cloud)
ENVIRONMENT=dev

# Supabase Cloud Configuration
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PROJECT_REF=your-project-ref

# Database URLs - Usa Transaction Pooler per connessioni production-ready
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Direct connection (solo per pg_dump/schema extraction)
SUPABASE_DB_DIRECT_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# Supabase API
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_API_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n Cloud Configuration
N8N_API_URL=https://your-instance.app.n8n.cloud/api/v1
N8N_API_KEY=your-n8n-api-key
# Optional: n8n webhook URL
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud
